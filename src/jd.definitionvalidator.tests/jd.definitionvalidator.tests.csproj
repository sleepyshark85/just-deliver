<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The real schema and sample are the fixtures, so the tests break when either drifts. -->
  <ItemGroup>
    <Content Include="../../schemas/workload.schema.json" Link="workload.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../samples/workloads/sample-app.yaml" Link="sample-workload.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../jd.definitionvalidator/jd.definitionvalidator.csproj" />
  </ItemGroup>

</Project>
