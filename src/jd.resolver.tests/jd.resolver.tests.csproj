<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The seed catalog is the fixture, so the tests break when it drifts from the formats. -->
  <ItemGroup>
    <Content Include="../../catalog/**/*.yaml" Link="catalog/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../samples/workloads/sample-app.yaml" Link="samples/workload.yaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../samples/workloads/*.yaml" Link="samples/workloads/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../samples/releases/*.yaml" Link="samples/releases/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../samples/environments/*.yaml" Link="samples/environments/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="golden/*.json;golden/*.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../jd.resolver/jd.resolver.csproj" />
  </ItemGroup>

</Project>
