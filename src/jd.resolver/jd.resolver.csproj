<Project Sdk="Microsoft.NET.Sdk">

  <!-- The catalog and environment formats are part of the code, so their schemas ship inside the assembly. -->
  <ItemGroup>
    <EmbeddedResource Include="../../schemas/catalog/*.schema.json" LogicalName="schemas/catalog/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../schemas/environment.schema.json" LogicalName="schemas/environment.schema.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../jd.definitionvalidator/jd.definitionvalidator.csproj" />
  </ItemGroup>

</Project>
