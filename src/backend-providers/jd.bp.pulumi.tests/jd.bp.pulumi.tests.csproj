<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The seed catalog (with its templates), sample workload and test environment are the fixtures: this is the catalog CI. -->
  <ItemGroup>
    <Content Include="../../../catalog/**/*.yaml" Link="catalog/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../samples/workloads/sample-app.yaml" Link="samples/workload.yaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../jd.resolver.tests/golden/seed-environment.yaml" Link="golden/seed-environment.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../jd.bp.pulumi/jd.bp.pulumi.csproj" />
  </ItemGroup>

</Project>
