<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The release record's schema and its committed example. -->
  <ItemGroup>
    <Content Include="../../schemas/release-record.schema.json" Link="schemas/release-record.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="golden/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../jd.orchestrator/jd.orchestrator.csproj" />
  </ItemGroup>

</Project>
