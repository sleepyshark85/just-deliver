{
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet format:*)",
      "Bash(tools/verify.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(az policy:*)",
      "Bash(az role:*)",
      "Bash(az ad:*)",
      "Bash(tools/sandbox/sandbox.sh:*)",
      "Bash(./tools/sandbox/sandbox.sh:*)",
      "Read(~/.just-deliver/**)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git config core.hooksPath:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/hooks/pre-commit-verify.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
