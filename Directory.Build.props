<Project>
  <!-- Shared settings for every project. Per-project files only declare what differs. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Low/moderate advisories on transitive packages stay visible as warnings; high/critical fail the build. -->
    <WarningsNotAsErrors>NU1901;NU1902</WarningsNotAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Required for IDE0005 (unused usings) to run on build, and for CS1591. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Production projects (under src/, not *.tests) document every public member (docs/engineering/csharp.md section 11); tests and samples need not. -->
    <NoWarn Condition="$(MSBuildProjectName.EndsWith('.tests')) or !$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src'))">$(NoWarn);CS1591</NoWarn>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
